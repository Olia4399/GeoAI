# ==========================================
# GeoAI 环境变量模板
# 复制为 .env 并填入真实值
# ==========================================

# ---- LLM (OpenAI 兼容) ----
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ---- Database ----
POSTGRES_DB=geoai
POSTGRES_USER=geoai
POSTGRES_PASSWORD=geoai123
DATABASE_URL=postgresql://geoai:geoai123@postgis:5432/geoai

# ---- Mapbox ----
VITE_MAPBOX_TOKEN=pk.your-mapbox-token-here

# ---- Cesium ----
VITE_CESIUM_ION_TOKEN=your-cesium-ion-token-here

# ---- Service URLs (Docker 内部网络) ----
SPATIAL_SERVICE_URL=http://spatial:8002
AGENT_SERVICE_URL=http://agent:8001
